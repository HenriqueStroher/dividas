# Copie este arquivo para .env.local e preencha os valores.

# URL do projeto Supabase.
# Local: "API_URL" em `npx supabase status` (http://127.0.0.1:54321).
# Produção: Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave publicável (pública por natureza; a proteção dos dados vem do RLS).
# Local: "PUBLISHABLE_KEY" em `npx supabase status`.
# Produção: Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
